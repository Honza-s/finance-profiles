{
  "id": "csob-karta",
  "bank": "ČSOB",
  "label": "ČSOB — platba kartou e-mailem",
  "version": 1,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "CZ",
    "keywords": [
      "čsob",
      "csob",
      "karta",
      "platba kartou",
      "moje info",
      "e-mail",
      "notifikace"
    ],
    "howTo": "Zpráva „Moje info - Platba kartou“, kterou ČSOB posílá při autorizaci karty. Načítá se ze schránky, ne ze souboru. Jde o blokaci, ne o zaúčtování — pohyb je předběžný a výpis ho později nahradí. Bere se částka blokace, protože ta je v měně účtu; částka v měně obchodníka zůstává v poznámce."
  },
  "detect": {
    "contentContains": [
      "Parametry transakce",
      "autorizována transakce platební kartou"
    ]
  },
  "documentFields": {
    "datum": {
      "pattern": "dne\\s+(\\d{1,2}\\.\\s?\\d{1,2}\\.\\s?\\d{4})\\s+\\d{1,2}:\\d{2}:\\d{2}\\s+byla autorizov",
      "group": 1
    },
    "castkaUctu": {
      "pattern": "Částka blokace\\s+([+\\u2212-]?[\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    },
    "menaUctu": {
      "pattern": "Částka blokace\\s+[+\\u2212-]?[\\d\\u00A0 ]+,\\d{2}\\s+([A-Z]{3})",
      "group": 1
    },
    "castkaTransakce": {
      "pattern": "Částka transakce\\s+([+\\u2212-]?[\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    },
    "menaTransakce": {
      "pattern": "Částka transakce\\s+[+\\u2212-]?[\\d\\u00A0 ]+,\\d{2}\\s+([A-Z]{3})",
      "group": 1
    },
    "misto": {
      "pattern": "Místo\\s+(.+)",
      "group": 1
    },
    "karta": {
      "pattern": "Číslo karty\\s+(\\*?\\d+)",
      "group": 1
    },
    "ucet": {
      "pattern": "Účet ke kartě\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "smer": {
      "pattern": "(autorizována transakce platební kartou)",
      "group": 1,
      "default": "autorizována transakce platební kartou"
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ]
    },
    "amount": {
      "from": "castkaUctu",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\u2212",
          "with": "-"
        }
      ],
      "fallback": {
        "from": "castkaTransakce",
        "number": {
          "decimal": ",",
          "grouping": " "
        },
        "transforms": [
          {
            "op": "replace",
            "pattern": "\\u2212",
            "with": "-"
          }
        ]
      }
    },
    "direction": {
      "field": {
        "from": "smer"
      },
      "debitValues": [
        "autorizována transakce platební kartou"
      ]
    },
    "currency": {
      "from": "menaUctu",
      "fallback": {
        "from": "menaTransakce",
        "default": "CZK"
      }
    },
    "accountNumber": {
      "from": "ucet"
    },
    "counterpartyName": {
      "from": "misto",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "operation": {
      "default": "Platba kartou"
    },
    "note": {
      "template": "karta {karta} · {castkaTransakce} {menaTransakce}",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    }
  }
}
