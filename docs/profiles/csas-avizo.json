{
  "id": "csas-avizo",
  "bank": "Česká spořitelna",
  "label": "Česká spořitelna — avízo o platbě e-mailem",
  "version": 1,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "CZ",
    "keywords": [
      "česká spořitelna",
      "ceska sporitelna",
      "čsas",
      "csas",
      "avízo",
      "přišla platba",
      "odešla platba",
      "e-mail",
      "notifikace"
    ],
    "howTo": "Zprávy „Přišla platba“, „Odešla platba“ a „Odešla trvalá platba“ z České spořitelny. Načítají se ze schránky, ne ze souboru. Pohyb je předběžný a výpis ho později nahradí. Zůstatek se schválně nebere: spořitelna píše zůstatek k dispozici, ne zaúčtovaný, a ten dvěma účtům nesedí."
  },
  "detect": {
    "contentContains": [
      "Informace o transakci",
      "Směr platby"
    ]
  },
  "documentFields": {
    "datum": {
      "pattern": "Datum a čas platby:\\s*(\\d{1,2}\\.\\s*\\d{1,2}\\.\\s*\\d{4})",
      "group": 1
    },
    "smer": {
      "pattern": "Směr platby:\\s*(\\S+)",
      "group": 1
    },
    "ucet": {
      "pattern": "Číslo účtu:\\s*([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "ucetZ": {
      "pattern": "Z účtu:\\s*([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "protiucet": {
      "pattern": "Číslo účtu protistrany:\\s*([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "protiucetNa": {
      "pattern": "Na účet:\\s*([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "castka": {
      "pattern": "Částka v měně účtu:\\s*([\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    },
    "mena": {
      "pattern": "Částka v měně účtu:\\s*[\\d\\u00A0 ]+,\\d{2}\\s*(Kč|[A-Z]{3})",
      "group": 1
    },
    "castkaTransakce": {
      "pattern": "Částka v měně transakce:\\s*([\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    },
    "menaTransakce": {
      "pattern": "Částka v měně transakce:\\s*[\\d\\u00A0 ]+,\\d{2}\\s*(Kč|[A-Z]{3})",
      "group": 1
    },
    "vs": {
      "pattern": "Variabilní symbol:\\s*(\\d+)",
      "group": 1
    },
    "ks": {
      "pattern": "Konstantní symbol:\\s*(\\d+)",
      "group": 1
    },
    "ss": {
      "pattern": "Specifický symbol:\\s*(\\d+)",
      "group": 1
    },
    "zprava": {
      "pattern": "Zpráva pro příjemce:\\s*(.+)",
      "group": 1
    },
    "ucel": {
      "pattern": "Účel platby:\\s*(.+)",
      "group": 1
    },
    "iban": {
      "pattern": "IBAN protistrany:\\s*([A-Z]{2}[0-9A-Z]{10,32})",
      "group": 1
    },
    "predmet": {
      "pattern": "((?:Přišla|Odešla)\\s+(?:trvalá\\s+)?platba)",
      "group": 1,
      "source": "fileName"
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ]
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "fallback": {
        "from": "castkaTransakce",
        "number": {
          "decimal": ",",
          "grouping": " "
        }
      }
    },
    "direction": {
      "field": {
        "from": "smer"
      },
      "debitValues": [
        "odchozí"
      ],
      "creditValues": [
        "příchozí"
      ]
    },
    "currency": {
      "from": "mena",
      "transforms": [
        {
          "op": "replace",
          "pattern": "Kč",
          "with": "CZK"
        }
      ],
      "fallback": {
        "from": "menaTransakce",
        "transforms": [
          {
            "op": "replace",
            "pattern": "Kč",
            "with": "CZK"
          }
        ],
        "default": "CZK"
      }
    },
    "accountNumber": {
      "from": "ucet",
      "fallback": {
        "from": "ucetZ"
      }
    },
    "counterpartyAccount": {
      "from": "protiucet",
      "fallback": {
        "from": "protiucetNa",
        "fallback": {
          "from": "iban"
        }
      }
    },
    "variableSymbol": {
      "from": "vs",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    },
    "constantSymbol": {
      "from": "ks",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    },
    "specificSymbol": {
      "from": "ss",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    },
    "message": {
      "from": "zprava",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ],
      "fallback": {
        "from": "ucel",
        "transforms": [
          {
            "op": "collapseSpaces"
          }
        ]
      }
    },
    "operation": {
      "from": "predmet",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ],
      "fallback": {
        "choose": {
          "on": "smer",
          "cases": {
            "příchozí": {
              "default": "Příchozí platba"
            },
            "odchozí": {
              "default": "Odchozí platba"
            }
          }
        }
      }
    }
  }
}
