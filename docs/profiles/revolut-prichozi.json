{
  "id": "revolut-prichozi",
  "bank": "Revolut",
  "label": "Revolut — oznámení příjemci (e-mail)",
  "version": 1,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "LT",
    "keywords": [
      "revolut",
      "you've been sent",
      "příchozí",
      "e-mail"
    ],
    "howTo": "E-mail „You've been sent …“, který Revolut posílá příjemci převodu. Platba přijde na účet příjemce v jiné bance — ten vyber při prvním načtení."
  },
  "detect": {
    "contentContains": [
      "Revolut",
      "sent you",
      "via a bank transfer"
    ]
  },
  "documentFields": {
    "datum": {
      "pattern": "(?m)^Sent on\\s*\\n\\s*([A-Z][a-z]+ \\d{1,2}, \\d{4})$",
      "group": 1
    },
    "castka": {
      "pattern": "sent you (?:€|£|\\$|CZK ?)([\\d,]+(?:\\.\\d{1,2})?)",
      "group": 1
    },
    "mena": {
      "pattern": "sent you (€|£|\\$|CZK)",
      "group": 1,
      "default": "EUR"
    },
    "odkoho": {
      "pattern": "(?m)^Sender\\s*\\n\\s*(.+)$",
      "group": 1
    },
    "zprava": {
      "pattern": "(?m)^Reference\\s*\\n\\s*(.+)$",
      "group": 1
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "M d, yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "January",
          "with": "1"
        },
        {
          "op": "replace",
          "pattern": "February",
          "with": "2"
        },
        {
          "op": "replace",
          "pattern": "March",
          "with": "3"
        },
        {
          "op": "replace",
          "pattern": "April",
          "with": "4"
        },
        {
          "op": "replace",
          "pattern": "May",
          "with": "5"
        },
        {
          "op": "replace",
          "pattern": "June",
          "with": "6"
        },
        {
          "op": "replace",
          "pattern": "July",
          "with": "7"
        },
        {
          "op": "replace",
          "pattern": "August",
          "with": "8"
        },
        {
          "op": "replace",
          "pattern": "September",
          "with": "9"
        },
        {
          "op": "replace",
          "pattern": "October",
          "with": "10"
        },
        {
          "op": "replace",
          "pattern": "November",
          "with": "11"
        },
        {
          "op": "replace",
          "pattern": "December",
          "with": "12"
        }
      ]
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ".",
        "grouping": ","
      }
    },
    "currency": {
      "from": "mena",
      "transforms": [
        {
          "op": "replace",
          "pattern": "€",
          "with": "EUR"
        },
        {
          "op": "replace",
          "pattern": "Kč",
          "with": "CZK"
        },
        {
          "op": "replace",
          "pattern": "\\$",
          "with": "USD"
        },
        {
          "op": "replace",
          "pattern": "£",
          "with": "GBP"
        },
        {
          "op": "trim"
        }
      ],
      "default": "EUR"
    },
    "counterpartyName": {
      "from": "odkoho",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "message": {
      "from": "zprava",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    }
  }
}
