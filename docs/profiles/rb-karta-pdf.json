{
  "id": "rb-karta-pdf",
  "bank": "Raiffeisenbank",
  "label": "Raiffeisenbank — výpis z kreditní karty (PDF)",
  "version": 1,
  "format": "textRegex",
  "catalogue": {
    "country": "CZ",
    "keywords": [
      "raiffeisenbank",
      "raiffeisen",
      "rb",
      "kreditní karta",
      "kartový účet",
      "výpis",
      "pdf"
    ],
    "howTo": "Měsíční výpis z kartového účtu kreditní karty Raiffeisenbank v PDF (přijde e-mailem nebo je v internetovém bankovnictví). Splátka karty („VAŠE PLATBA - DĚKUJEME“) se načte jako příchozí platba a spáruje se s odchozí platbou z běžného účtu. Kartu přiřadíš k účtu tak, že mu dáš jako číslo účtu číslo karty, jak ho banka tiskne (531533XXXXXX1234) — stejně jako u CSV z téže karty."
  },
  "detect": {
    "contentContains": [
      "VÝPIS Z KARTOVÉHO ÚČTU",
      "Přehled transakcí",
      "Raiffeisenbank"
    ]
  },
  "textRegex": {
    "encoding": "utf-8",
    "multiline": true,
    "dotAll": false,
    "startAt": "Přehled transakcí",
    "stopAt": "Celkem za kartový účet",
    "pattern": "^(?<datum>\\d{2}\\. \\d{2}\\. \\d{4})(?:[ ]+(?<zauct>\\d{2}\\. \\d{2}\\. \\d{4}))?[ ]+(?<popis>.*?)[ ]+(?<castka>[+-]\\d{1,3}(?:\\.\\d{3})*,\\d{2})[ \\t]*\\r?\\n(?<zbytek>(?:(?!\\d{2}\\. \\d{2}\\. \\d{4}[ ])(?!Strana \\d)(?!Raiffeisenbank a\\.s\\.)(?!K\\d{7} )(?!VÝPIS Z KARTOVÉHO ÚČTU)(?!Výpis za období)(?!Držitel karty)(?!Číslo a název karty)(?!Datum Datum)(?!transakce zaúčtování)(?!Celkem za)(?!Připsáno \\()[^\\r\\n]*\\r?\\n?)*)"
  },
  "documentFields": {
    "karta": {
      "pattern": "Číslo a název karty:\\s*(\\d{6}[xX*]{6}\\d{4})",
      "group": 1
    },
    "mena": {
      "pattern": "Připsáno \\(([A-Z]{3})\\)",
      "group": 1,
      "default": "CZK"
    }
  },
  "checks": {
    "creditSum": {
      "pattern": "Celkem za kartový účet[ ]+\\+?([\\d.]+,\\d{2})",
      "group": 1
    },
    "debitSum": {
      "pattern": "Celkem za kartový účet[ ]+\\+?[\\d.]+,\\d{2}[ ]+-?([\\d.]+,\\d{2})",
      "group": 1
    },
    "number": {
      "decimal": ",",
      "grouping": "."
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ]
    },
    "bookingDate": {
      "from": "zauct",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ]
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ",",
        "grouping": "."
      }
    },
    "currency": {
      "from": "mena",
      "default": "CZK"
    },
    "accountNumber": {
      "from": "karta",
      "transforms": [
        {
          "op": "upper"
        }
      ]
    },
    "counterpartyName": {
      "from": "popis",
      "transforms": [
        {
          "op": "replace",
          "pattern": "^(DEKUJEME|DĚKUJEME),\\s*",
          "with": ""
        },
        {
          "op": "replace",
          "pattern": "^VAŠE PLATBA - DĚKUJEME$",
          "with": ""
        },
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "operation": {
      "from": "zbytek",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "bankCategory": {
      "from": "popis",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(VAŠE PLATBA - DĚKUJEME)$",
          "group": 1
        }
      ]
    }
  },
  "bankCategoryMapping": {
    "VAŠE PLATBA - DĚKUJEME": "Převod"
  }
}
