{
  "id": "rb-avizo",
  "bank": "Raiffeisenbank",
  "label": "Raiffeisenbank — Pohyb na účtě (e-mail Informuj mě)",
  "version": 2,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "CZ",
    "keywords": [
      "raiffeisenbank",
      "raiffeisen",
      "rb",
      "informuj mě",
      "pohyb na účtě",
      "avízo",
      "e-mail",
      "notifikace"
    ],
    "howTo": "E-mail „Pohyb na účtě“ ze služby Informuj mě (info@rb.cz). Načítá se ze schránky, ne ze souboru — v nastavení schránky přidej odesílatele rb.cz. Pohyb je předběžný a výpis ho později nahradí. Svůj účet pozná podle čísla v e-mailu (u příchozí platby „Na účet“, u odchozí „Z účtu“)."
  },
  "detect": {
    "contentContains": [
      "Informuj mě",
      "Raiffeisenbank",
      "Částka v měně účtu"
    ],
    "contentPattern": "(příchozí|odchozí) transakce"
  },
  "documentFields": {
    "smer": {
      "pattern": "následující\\s+(příchozí|odchozí)\\s+transakce",
      "group": 1
    },
    "datum": {
      "pattern": "Datum a čas\\s+(\\d{1,2}\\.\\s?\\d{1,2}\\.\\s?\\d{4})",
      "group": 1
    },
    "ucetPrichozi": {
      "pattern": "(?s)příchozí\\s+transakce.*?Na účet\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "ucetOdchozi": {
      "pattern": "(?s)odchozí\\s+transakce.*?Z účtu\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "protiucetPrichozi": {
      "pattern": "(?s)příchozí\\s+transakce.*?Z účtu\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "protiucetOdchozi": {
      "pattern": "(?s)odchozí\\s+transakce.*?Na účet\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "jmenoPrichozi": {
      "pattern": "(?s)příchozí\\s+transakce.*?Z účtu\\s+[0-9-]+/[0-9]{4}[ \\t]*\\r?\\n\\s*([^\\r\\n]+)",
      "group": 1
    },
    "jmenoOdchozi": {
      "pattern": "(?s)odchozí\\s+transakce.*?Na účet\\s+[0-9-]+/[0-9]{4}[ \\t]*\\r?\\n\\s*([^\\r\\n]+)",
      "group": 1
    },
    "castka": {
      "pattern": "Částka v měně účtu\\s+([+\\u2212-]?[\\d\\u00A0 .]+,\\d{2})",
      "group": 1
    },
    "mena": {
      "pattern": "Částka v měně účtu\\s+[+\\u2212-]?[\\d\\u00A0 .]+,\\d{2}\\s*(Kč|[A-Z]{3})",
      "group": 1,
      "default": "CZK"
    },
    "kategorie": {
      "pattern": "Kategorie pohybu\\s+([^\\r\\n]+)",
      "group": 1
    },
    "typ": {
      "pattern": "Typ pohybu\\s+([^\\r\\n]+)",
      "group": 1
    },
    "detaily": {
      "pattern": "Detaily\\s+([^\\r\\n]+)",
      "group": 1
    },
    "zprava": {
      "pattern": "Zpráva pro příjemce\\s+([^\\r\\n]+)",
      "group": 1
    },
    "vs": {
      "pattern": "Variabilní symbol\\s+(\\d+)",
      "group": 1
    },
    "ks": {
      "pattern": "Konstantní symbol\\s+(\\d+)",
      "group": 1
    },
    "ss": {
      "pattern": "Specifický symbol\\s+(\\d+)",
      "group": 1
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ]
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "transforms": [
        {
          "op": "replace",
          "pattern": "[+\\u2212-]",
          "with": ""
        },
        {
          "op": "replace",
          "pattern": "[.\\u00A0]",
          "with": ""
        }
      ]
    },
    "direction": {
      "field": {
        "from": "smer"
      },
      "debitValues": [
        "odchozí"
      ],
      "creditValues": [
        "příchozí"
      ]
    },
    "currency": {
      "from": "mena",
      "transforms": [
        {
          "op": "replace",
          "pattern": "Kč",
          "with": "CZK"
        }
      ],
      "default": "CZK"
    },
    "accountNumber": {
      "from": "ucetPrichozi",
      "fallback": {
        "from": "ucetOdchozi"
      }
    },
    "counterpartyAccount": {
      "from": "protiucetPrichozi",
      "fallback": {
        "from": "protiucetOdchozi"
      }
    },
    "counterpartyName": {
      "from": "jmenoPrichozi",
      "fallback": {
        "from": "jmenoOdchozi",
        "fallback": {
          "from": "detaily",
          "transforms": [
            {
              "op": "replace",
              "pattern": "\\s*\\([0-9/ -]+\\)\\s*$",
              "with": ""
            },
            {
              "op": "collapseSpaces"
            }
          ]
        }
      }
    },
    "message": {
      "from": "zprava"
    },
    "note": {
      "from": "detaily",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s*\\([0-9/ -]+\\)\\s*$",
          "with": ""
        }
      ]
    },
    "operation": {
      "from": "typ"
    },
    "bankCategory": {
      "from": "kategorie"
    },
    "variableSymbol": {
      "from": "vs",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    },
    "constantSymbol": {
      "from": "ks",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    },
    "specificSymbol": {
      "from": "ss",
      "transforms": [
        {
          "op": "regexExtract",
          "pattern": "^(?!0+$)(\\d+)$",
          "group": 1
        }
      ]
    }
  },
  "bankCategoryMapping": {
    "Úrok": "Úroky"
  }
}
