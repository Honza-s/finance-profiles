{
  "id": "revolut-odchozi",
  "bank": "Revolut",
  "label": "Revolut — odeslaný převod (e-mail)",
  "version": 1,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "LT",
    "keywords": [
      "revolut",
      "převod",
      "e-mail",
      "avízo",
      "odeslali jste"
    ],
    "howTo": "E-mail „Odeslali jste … uživateli …“, který Revolut posílá po odeslání převodu. Načítá se ze schránky."
  },
  "detect": {
    "contentContains": [
      "Revolut",
      "Váš převod byl úspěšný"
    ]
  },
  "documentFields": {
    "datum": {
      "pattern": "(?m)^Datum zprávy: (\\d{1,2}\\.\\d{1,2}\\.\\d{4})$",
      "group": 1
    },
    "castka": {
      "pattern": "odeslali jste ([\\d\\u00A0\\u202F ]+(?:,\\d{1,2})?)[\\s\\u00A0\\u202F]*(?:€|Kč|\\$|£)",
      "group": 1
    },
    "mena": {
      "pattern": "odeslali jste [\\d\\u00A0\\u202F ]+(?:,\\d{1,2})?[\\s\\u00A0\\u202F]*(€|Kč|\\$|£)",
      "group": 1,
      "default": "EUR"
    },
    "komu": {
      "pattern": "uživateli (.+?)\\.\\s",
      "group": 1
    },
    "zprava": {
      "pattern": "(?m)^Reference\\s*\\n\\s*(.+)$",
      "group": 1
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy"
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "transforms": [
        {
          "op": "replace",
          "pattern": "[\\u00A0\\u202F ]",
          "with": ""
        }
      ]
    },
    "direction": {
      "field": {
        "default": "odchozi"
      },
      "debitValues": [
        "odchozi"
      ]
    },
    "currency": {
      "from": "mena",
      "transforms": [
        {
          "op": "replace",
          "pattern": "€",
          "with": "EUR"
        },
        {
          "op": "replace",
          "pattern": "Kč",
          "with": "CZK"
        },
        {
          "op": "replace",
          "pattern": "\\$",
          "with": "USD"
        },
        {
          "op": "replace",
          "pattern": "£",
          "with": "GBP"
        },
        {
          "op": "trim"
        }
      ],
      "default": "EUR"
    },
    "counterpartyName": {
      "from": "komu",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "message": {
      "from": "zprava",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    }
  }
}
