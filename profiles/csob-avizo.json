{
  "id": "csob-avizo",
  "bank": "ČSOB",
  "label": "ČSOB — avízo e-mailem",
  "version": 1,
  "format": "single",
  "kind": "notification",
  "catalogue": {
    "country": "CZ",
    "keywords": [
      "čsob",
      "csob",
      "avízo",
      "e-mail",
      "notifikace"
    ],
    "howTo": "Avízo o platbě, které ČSOB posílá e-mailem. Načítá se ze schránky, ne ze souboru."
  },
  "detect": {
    "contentContains": [
      "Parametry platby",
      "zaúčtována transakce typu"
    ]
  },
  "documentFields": {
    "datum": {
      "pattern": "Datum účtování\\s+(\\d{1,2}\\.\\s?\\d{1,2}\\.\\s?\\d{4})",
      "group": 1
    },
    "datumZahlavi": {
      "pattern": "dne\\s+(\\d{1,2}\\.\\s?\\d{1,2}\\.\\s?\\d{4})\\s+byla",
      "group": 1
    },
    "ucetVypisu": {
      "pattern": "(?m)^\\s*Účet\\s+([0-9-]+/[0-9]{4})\\s*$",
      "group": 1
    },
    "protiucet": {
      "pattern": "Účet protistrany\\s+([0-9-]+/[0-9]{4})",
      "group": 1
    },
    "jmeno": {
      "pattern": "Název protistrany\\s+(.+)",
      "group": 1
    },
    "castka": {
      "pattern": "(?m)^\\s*Částka\\s+([+\\u2212-]?[\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    },
    "mena": {
      "pattern": "(?m)^\\s*Částka\\s+[+\\u2212-]?[\\d\\u00A0 ]+,\\d{2}\\s+([A-Z]{3})",
      "group": 1,
      "default": "CZK"
    },
    "vs": {
      "pattern": "Variabilní symbol\\s+(\\d+)",
      "group": 1
    },
    "ks": {
      "pattern": "Konstantní symbol\\s+(\\d+)",
      "group": 1
    },
    "ss": {
      "pattern": "Specifický symbol\\s+(\\d+)",
      "group": 1
    },
    "zprava": {
      "pattern": "Zpráva pro příjemce\\s+(.+)",
      "group": 1
    },
    "operace": {
      "pattern": "transakce typu:\\s*([^.\\n]+)",
      "group": 1
    },
    "zustatek": {
      "pattern": "Zůstatek na účtu po zaúčtování transakce:\\s*([+\\u2212-]?[\\d\\u00A0 ]+,\\d{2})",
      "group": 1
    }
  },
  "row": {
    "date": {
      "from": "datum",
      "date": "d.M.yyyy",
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\s",
          "with": ""
        }
      ],
      "fallback": {
        "from": "datumZahlavi",
        "date": "d.M.yyyy",
        "transforms": [
          {
            "op": "replace",
            "pattern": "\\s",
            "with": ""
          }
        ]
      }
    },
    "amount": {
      "from": "castka",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\u2212",
          "with": "-"
        }
      ]
    },
    "balance": {
      "from": "zustatek",
      "number": {
        "decimal": ",",
        "grouping": " "
      },
      "transforms": [
        {
          "op": "replace",
          "pattern": "\\u2212",
          "with": "-"
        }
      ]
    },
    "currency": {
      "from": "mena",
      "default": "CZK"
    },
    "accountNumber": {
      "from": "ucetVypisu"
    },
    "counterpartyAccount": {
      "from": "protiucet"
    },
    "counterpartyName": {
      "from": "jmeno",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "variableSymbol": {
      "from": "vs"
    },
    "constantSymbol": {
      "from": "ks"
    },
    "specificSymbol": {
      "from": "ss"
    },
    "message": {
      "from": "zprava",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    },
    "operation": {
      "from": "operace",
      "transforms": [
        {
          "op": "collapseSpaces"
        }
      ]
    }
  }
}
